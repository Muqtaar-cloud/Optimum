# Copy to .env and fill in. Never commit .env.

# 1 = push codes to your phone only, 2 = also auto-redeem, 3 = also auto-mint
STAGE=1
# 1 = fill the code field but never submit (stage 2+)
DRY_RUN=0

# --- Relay (stage 1+) ---
NTFY_SERVER=https://ntfy.sh
# Long random names (20+ chars). Anyone who knows a topic can read or post to it.
# Generate with:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
NTFY_TOPIC_IN=
NTFY_TOPIC_OUT=
# Shared secret MacroDroid puts in every message (16+ chars, generate the same way)
RELAY_TOKEN=
# @get_optimum's display name exactly as it appears as the X notification title (set from a CAPTURE)
X_DISPLAY_NAME=Optimum
# Comma-separated phrases that mark likes/quotes/mentions rather than posts
IGNORE_PHRASES=liked your,reposted your,quoted your,mentioned you
# Opens the mint page inside your phone wallet's in-app browser when you tap an alert
WALLET_DEEPLINK=https://metamask.app.link/dapp/turbocards.getoptimum.xyz/optimum

# --- Wallet (stage 2+) ---
# Private key of the FRESH funded test wallet. Never your main wallet.
BURNER_KEY=
# Ethereum mainnet RPC (e.g. a free Alchemy/Infura/public endpoint)
RPC_URL=
# Gas caps; above them the bot waits up to 30 min, then alerts
MAX_FEE_GWEI=30
MAX_GAS_ETH=0.005
# Optional: full path to chrome.exe if Playwright can't find your installed Chrome
BROWSER_PATH=
# Regex for the wallet option to pick in Snag's connect dialog
WALLET_OPTION_TEXT=TurboBot|Browser Wallet|Injected

# --- Auto-mint (stage 3) ---
# From YOUR first manual mint tx on Etherscan: the "To" address and the 4-byte method id
MINT_TO=
MINT_SELECTOR=
# Text that identifies a TurboCards card on the page (clicks are scoped to that card)
MINT_CARD_TEXT=Turbo
